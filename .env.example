NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pokemon-go-api
POKEMON_GO_DATA_DIR=../PokemonGo-Data
POKEMON_GO_DATA_REPO=https://github.com/Matthieu-Vachet/PokemonGo-Data.git
POKEMON_GO_DATA_REF=main
POKEMON_GO_DATA_TOKEN=
API_BASE_PATH=/api/v1
API_PUBLIC_URL=http://localhost:3000
API_ADMIN_SECRET=change_me
CORS_ORIGINS=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=5000
TRUST_PROXY=1
SYNC_DELETE_STALE=true
