    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "lucide-react": "^1.20.0",
    "mongoose": "^9.6.3",
    "morgan": "^1.11.0",
    "next": "^15.5.19",
    "postcss": "^8.5.15",
    "puppeteer-core": "^25.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.3.1",
    "zod": "^4.4.3"
