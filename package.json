{
  "name": "pokemon-go-api",
  "version": "1.0.0",
  "description": "API REST publique et multilingue pour Pokemon GO",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "sync": "node scripts/sync/run.js",
    "sync:watch": "node scripts/sync/watch.js",
    "sync:dry": "node scripts/sync/run.js --dry-run",
    "audit:moves": "node scripts/audit/moves.js",
    "audit:identifiers": "node scripts/audit/identifiers.js",
    "migrate:moves:catalog": "node scripts/migrate/complete-move-catalog.js",
    "migrate:moves:catalog:write": "node scripts/migrate/complete-move-catalog.js --write",
    "migrate:moves": "node scripts/migrate/normalize-moves.js",
    "migrate:moves:write": "node scripts/migrate/normalize-moves.js --write",
    "migrate:types": "node scripts/migrate/normalize-types.js",
    "migrate:types:write": "node scripts/migrate/normalize-types.js --write",
    "migrate:max-forms": "node scripts/migrate/normalize-max-forms.js",
    "migrate:max-forms:write": "node scripts/migrate/normalize-max-forms.js --write",
    "migrate:identifiers": "node scripts/migrate/normalize-identifiers.js",
    "migrate:identifiers:write": "node scripts/migrate/normalize-identifiers.js --write",
    "test": "node --test",
    "check": "npm run sync:dry && npm test",
    "checklist": "node apps/checklist/server/local-server.js"
  },
  "keywords": [
    "pokemon",
    "pokemon-go",
    "api",
    "rest",
    "pvp",
    "pokedex"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "mongoose": "^9.6.3",
    "morgan": "^1.11.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
