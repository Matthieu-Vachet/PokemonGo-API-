{
  "name": "pokemon-go-api",
  "version": "1.0.0",
  "description": "API REST publique et multilingue pour Pokemon GO",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "sync": "node scripts/sync.js",
    "sync:watch": "node scripts/sync-watch.js",
    "sync:dry": "node scripts/sync.js --dry-run",
    "test": "node --test",
    "check": "npm run sync:dry && npm test",
    "checklist": "node scripts/checklist-server.js",
    "checklist:v2": "node scripts/checklist-v2-server.js",
    "checklist:v3": "node scripts/checklist-v3-server.js",
    "scrape": "node scraper-advanced.js",
    "scrape:gen1": "node scraper-advanced.js 1 151",
    "scrape:gen2": "node scraper-advanced.js 152 251",
    "scrape:single": "node scraper-advanced.js"
  },
  "keywords": [
    "pokemon",
    "pokemon-go",
    "api",
    "rest",
    "pvp",
    "pokedex"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.16.1",
    "cheerio": "^1.2.0",
    "chokidar": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "mongoose": "^9.6.3",
    "morgan": "^1.11.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
