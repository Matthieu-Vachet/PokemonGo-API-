{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "pages/api/rest.js": {
      "maxDuration": 60
    },
    "pages/api/checklist-v3.js": {
      "maxDuration": 60
    },
    "api/blocked.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "^/(?:data|runtime-data|config|docs|src|test|apps)(?:/.*)?$", "dest": "/api/blocked" },
    { "handle": "filesystem" },
    { "src": "^/(api/v1(?:/.*)?|api-docs(?:/.*)?|api-docs\\.json|swagger(?:/.*)?|health)$", "dest": "/api/rest" }
  ]
}
