{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/rest.js": {
      "includeFiles": "{.data/PokemonGo-Data/{pokemon,pokemon-forms,pokemon-assets,pvp,moves,generations,types,weather,stickers,raids,eggs,max-battles,rocket,research,items,mappings,scripts,game-master,checklist,schemas,source-watch}/**,.data/PokemonGo-Data/*report.json,data/**}",
      "maxDuration": 60
    },
    "api/checklist-v3.js": {
      "includeFiles": "{.data/PokemonGo-Data/{pokemon,pokemon-forms,pokemon-assets,pvp,moves,generations,types,weather,stickers,raids,eggs,max-battles,rocket,research,items,mappings,scripts,game-master,checklist,schemas,source-watch}/**,.data/PokemonGo-Data/*report.json,data/**}",
      "maxDuration": 60
    },
    "api/blocked.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "^/(?:data|config|docs|src|test|apps)(?:/.*)?$", "dest": "/api/blocked" },
    { "handle": "filesystem" },
    { "src": "^/(api/v1(?:/.*)?|api-docs(?:/.*)?|api-docs\\.json|swagger(?:/.*)?|health)$", "dest": "/api/rest" }
  ]
}
