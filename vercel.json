{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/rest.js": {
      "includeFiles": "{.data/PokemonGo-Data/{data/{pokemon,assets,moves,reference},mappings,tooling,schemas,operations/audits}/**,.data/PokemonGo-Data/data/pvp/{pokemon,manifests}/**,.data/PokemonGo-Data/data/{battles,activities}/**,data/**}",
      "maxDuration": 60
    },
    "api/checklist-v3.js": {
      "includeFiles": "{.data/PokemonGo-Data/{data/{pokemon,assets,moves,reference},mappings,tooling,schemas,operations/audits}/**,.data/PokemonGo-Data/data/pvp/{pokemon,manifests}/**,.data/PokemonGo-Data/data/{battles,activities}/**,data/**}",
      "maxDuration": 60
    },
    "api/blocked.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "^/(?:data|config|docs|src|test|apps)(?:/.*)?$", "dest": "/api/blocked" },
    { "handle": "filesystem" },
    { "src": "^/(api/v1(?:/.*)?|api-docs(?:/.*)?|api-docs\\.json|swagger(?:/.*)?|health)$", "dest": "/api/rest" }
  ]
}
